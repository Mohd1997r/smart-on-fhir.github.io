function getSheet_(name){var sh=getSpreadsheet_().getSheetByName(name); if(!sh) throw appError_('SHEET_MISSING',name); return sh;}
function readHeaders_(sh){var last=sh.getLastColumn(); if(!last) return []; return sh.getRange(1,1,1,last).getValues()[0].map(String);}
function ensureSheet_(ss,name,headers){var sh=ss.getSheetByName(name)||ss.insertSheet(name); var existing=readHeaders_(sh); if(existing.length===0){sh.getRange(1,1,1,headers.length).setValues([headers]); sh.setFrozenRows(1);} else {headers.forEach(function(h){if(existing.indexOf(h)<0){sh.getRange(1,sh.getLastColumn()+1).setValue(h); existing.push(h);}});} return sh;}
function readTable_(name){var sh=getSheet_(name), headers=readHeaders_(sh), last=sh.getLastRow(); if(last<2) return {headers:headers,rows:[]}; var vals=sh.getRange(2,1,last-1,headers.length).getValues(); var rows=[]; vals.forEach(function(r,i){ if(r.every(function(c){return c===''||c==null;})) return; var o={sheetRowNumber:i+2}; headers.forEach(function(h,j){o[h]=r[j] instanceof Date?Utilities.formatDate(r[j],DCU.TZ,'yyyy-MM-dd'):r[j];}); rows.push(o);}); return {headers:headers,rows:rows};}
function appendRow_(name,obj){var sh=getSheet_(name), h=readHeaders_(sh); sh.appendRow(h.map(function(k){return obj[k]!==undefined?obj[k]:'';})); return sh.getLastRow();}
function updateRow_(name,rowNumber,patch){var sh=getSheet_(name), h=readHeaders_(sh); Object.keys(patch).forEach(function(k){var i=h.indexOf(k); if(i>=0) sh.getRange(rowNumber,i+1).setValue(patch[k]);});}
function findBy_(name,field,value){return readTable_(name).rows.filter(function(r){return String(r[field])===String(value);});}
