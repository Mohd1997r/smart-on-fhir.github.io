function getCurrentUser_(){var email=(Session.getActiveUser().getEmail()||'').toLowerCase(); if(!email) throw appError_('ACCESS_DENIED','Authorized staff only.'); var row=findBy_('Users Roles','Email',email).filter(function(r){return r.IsActive==='Yes';})[0]; if(!row) throw appError_('ACCESS_DENIED','Authorized staff only.'); return {email:email,role:row.Role,specialties:String(row.Specialties||'').split(',').map(function(s){return s.trim();}).filter(Boolean),canViewMRN:row.CanViewMRN==='Yes',canViewMobile:row.CanViewMobile==='Yes'};}
function requireRole_(roles){var u=getCurrentUser_(); if(roles.indexOf(u.role)<0) throw appError_('FORBIDDEN','Insufficient permission.'); return u;}
function canSeeSpecialty_(u,s){return u.role!=='Doctor'||u.specialties.indexOf(s)>=0;}
function requireSpecialty_(u,s){if(!canSeeSpecialty_(u,s)) throw appError_('FORBIDDEN_SPECIALTY','Specialty not allowed.');}
function apiGetBootstrap(){var u=getCurrentUser_(); return {user:{email:u.email,role:u.role,specialties:u.specialties},mode:getSystemMode_(),specialties:DCU.SPECIALTIES.map(function(s){return {en:s[0],ar:s[1],icon:s[2]};}),medications:DcuLogic.medRows().filter(function(m){return m.IsActive==='Yes';}),notice:'Authorized staff only / للموظفين المصرح لهم فقط'};}
