function monthSheetName_(date){var d=DcuLogic.parseDate(date); return d.getUTCFullYear()+' '+['January','February','March','April','May','June','July','August','September','October','November','December'][d.getUTCMonth()];}
function updateMonthlyDay_(date){var ss=getSpreadsheet_(), name=monthSheetName_(date), sh=ss.getSheetByName(name); if(!sh) return; var all=readTable_('Booking Data').rows.filter(function(b){return b.AppointmentDate===date&&b.BookingStatus==='Booked';}); var finder=sh.createTextFinder('DATE:'+date).matchEntireCell(true).findNext(); if(!finder) return; var start=finder.getRow()+1, end=start; while(end<=sh.getLastRow() && String(sh.getRange(end,1).getValue()).indexOf('DATE:')!==0) end++; if(end>start) sh.getRange(start,1,end-start,MONTH_COLUMNS.length).clearContent(); var out=[]; all.forEach(function(b,i){out.push([i+1,b.PatientName,b.MRN,b.MobileNumber||'',(b.Diagnosis||'')+' / '+b.MedicationName,b.AppointmentDate,b.Consultant,b.PreviousAppointmentDate||'']);}); if(out.length) sh.getRange(start,1,out.length,MONTH_COLUMNS.length).setValues(out);}
