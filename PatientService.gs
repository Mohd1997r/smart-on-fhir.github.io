function upsertPatient_(u,data){var mrn=normalizeMrn_(data.MRN), rows=findBy_('Patients','MRN',mrn).filter(function(r){return r.IsActive!=='No';}); if(rows[0]){updateRow_('Patients',rows[0].sheetRowNumber,{PatientName:sanitizeText_(data.PatientName)||rows[0].PatientName,MobileNumber:sanitizeText_(data.MobileNumber)||rows[0].MobileNumber,Specialty:sanitizeText_(data.Specialty)||rows[0].Specialty,Consultant:sanitizeText_(data.Consultant)||rows[0].Consultant,Diagnosis:sanitizeText_(data.Diagnosis)||rows[0].Diagnosis,ModifiedAt:now_(),ModifiedBy:u.email}); return rows[0].PatientID;} var id=uuid_('PAT'); appendRow_('Patients',{PatientID:id,MRN:mrn,PatientName:sanitizeText_(data.PatientName),MobileNumber:sanitizeText_(data.MobileNumber),Specialty:sanitizeText_(data.Specialty),Consultant:sanitizeText_(data.Consultant),Diagnosis:sanitizeText_(data.Diagnosis),CreatedAt:now_(),CreatedBy:u.email,IsActive:'Yes'}); audit_(u,'CREATE','Patient',id,{}, {MRN:'[REDACTED]'},''); return id;}
function apiFindPatient(mrn){var u=requireRole_(['Admin','Manager','Charge Nurse','Booking Staff','Nurse','Read Only']); var rows=findBy_('Patients','MRN',normalizeMrn_(mrn)); return rows.map(function(r){return {MRN:r.MRN,PatientName:r.PatientName,Specialty:r.Specialty,Consultant:r.Consultant,Diagnosis:r.Diagnosis,MobileNumber:u.canViewMobile?r.MobileNumber:''};})[0]||null;}
