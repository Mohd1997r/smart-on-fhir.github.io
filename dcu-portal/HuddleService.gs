var HuddleService=(function(){function build(date){var u=AuthService.currentUser(); var books=AuthService.filterRowsByUser(SheetRepository.readTable(DCU.SHEETS.BOOK).filter(function(b){return b.AppointmentDate===date&&b.BookingStatus==='Booked';}),u); var arr=SheetRepository.readTable(DCU.SHEETS.ARRIVALS).filter(function(a){return a.VisitDate===date;}); var byMrn={}; arr.forEach(function(a){byMrn[a.MRN]=a;}); var rows=books.map(function(b,i){var a=byMrn[b.MRN]||{}; return {Sequence:i+1,Room:a.Room||'',PatientName:b.PatientName,MRN:b.MRN,MobileNumber:u.canViewMobile?(a.MobileNumber||b.MobileNumber||''):'',Responded:a.Responded||'',LabsIn:a.LabsStatus||'Not Required',Diagnosis:a.Diagnosis||'',MedicationID:b.MedicationID,Consultant:b.Consultant,Specialty:b.Specialty,AssignedStaff:a.PrimaryNurse||'',Diet:a.Diet||'',ArrivalStatus:a.ArrivalStatus||'Not Arrived',BookingStatus:b.BookingStatus,Notes:u.role==='Doctor'?'':(a.Notes||'')};}); var alerts=[]; books.forEach(function(b){if(b.BookingType==='Manual') alerts.push({type:'Manual Addition',BookingID:b.BookingID}); if(b.PreviousBookingID) alerts.push({type:'Changed Appointment',PreviousAppointmentDate:b.PreviousAppointmentDate});}); SheetRepository.readTable(DCU.SHEETS.REQ).filter(function(r){return ['Failed','Need Review'].indexOf(r.RequestStatus)>=0;}).forEach(function(r){alerts.push({type:'Failed Booking Request',RequestID:r.RequestID});}); var metrics={TotalPatients:rows.length,PatientsBySpecialty:{},PatientsByMedication:{},FirstDoseCount:0,ProceduresCount:0,IVIGCount:0,DesferalCount:0,BloodTransfusionCount:0,IronSucroseCount:0,FerinjectCount:0}; rows.forEach(function(r){metrics.PatientsBySpecialty[r.Specialty]=(metrics.PatientsBySpecialty[r.Specialty]||0)+1; metrics.PatientsByMedication[r.MedicationID]=(metrics.PatientsByMedication[r.MedicationID]||0)+1;}); return {date:date,metrics:metrics,rows:rows,alerts:alerts,lastUpdated:new Date()};} function home(date){var h=build(date); return {todayBookings:h.metrics.TotalPatients,arrived:h.rows.filter(function(r){return r.ArrivalStatus==='Arrived';}).length,notArrived:h.rows.filter(function(r){return r.ArrivalStatus==='Not Arrived';}).length,inTreatment:h.rows.filter(function(r){return r.ArrivalStatus==='In Treatment';}).length,completed:h.rows.filter(function(r){return r.ArrivalStatus==='Completed';}).length,pendingRequests:SheetRepository.readTable(DCU.SHEETS.REQ).filter(function(r){return ['New','Processing','Awaiting Nurse Confirmation'].indexOf(r.RequestStatus)>=0;}).length,manualAdditions:h.alerts.filter(function(a){return a.type==='Manual Addition';}).length,appointmentChanges:h.alerts.filter(function(a){return a.type==='Changed Appointment';}).length,capacityAlerts:h.alerts.length,lastUpdated:new Date()};} return {build:build,home:home};})();
