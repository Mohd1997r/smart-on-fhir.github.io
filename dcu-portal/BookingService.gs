var BookingService=(function(){
function createRequest(data,type){var u=AuthService.requireRole(['Admin','Manager','Charge Nurse','Booking Staff','Nurse']); ValidationService.required(data,['MRN','PatientName','MedicationID','Specialty','RequestedAppointmentDate']); if(type==='Manual') ValidationService.required(data,['Reason']); var req={RequestID:data.RequestID||Utilities.getUuid(),MRN:ValidationService.mrn(data.MRN),PatientName:data.PatientName,MedicationID:data.MedicationID,Specialty:data.Specialty,Consultant:data.Consultant||'',DoseNumber:data.DoseNumber||'',FirstDose:data.FirstDose?'Yes':'No',RequestedAppointmentDate:data.RequestedAppointmentDate,Reason:data.Reason||'',RequestStatus:'New',BookingType:type||'System',CreatedBy:u.email,CreatedAt:new Date()}; SheetRepository.appendRow(DCU.SHEETS.REQ,req); AuditService.log('CREATE','Booking Requests',req.RequestID,null,{RequestID:req.RequestID},req.Reason); return processRequest(req.RequestID);}
function processRequest(requestId,confirmAlternative){var lock=LockService.getScriptLock(); lock.waitLock(30000); try{var reqs=SheetRepository.readTable(DCU.SHEETS.REQ), req=reqs.filter(function(r){return r.RequestID===requestId;})[0]; if(!req) throw new Error('REQUEST_NOT_FOUND'); var existing=SheetRepository.readTable(DCU.SHEETS.BOOK).filter(function(b){return b.RequestID===requestId;})[0]; if(existing) return {status:existing.BookingStatus,bookingId:existing.BookingID}; var next=CapacityService.next({date:req.RequestedAppointmentDate,mrn:req.MRN,medicationId:req.MedicationID,firstDose:req.FirstDose==='Yes'}); if(next.status==='Need Review'){SheetRepository.updateRow(DCU.SHEETS.REQ,req.sheetRowNumber,{RequestStatus:'Need Review'}); WaitingListService.create(req,next.code); return next;} if(next.requiresConfirmation && !confirmAlternative){SheetRepository.updateRow(DCU.SHEETS.REQ,req.sheetRowNumber,{RequestStatus:'Awaiting Nurse Confirmation',AlternativeDate:next.date}); return next;} var b={BookingID:Utilities.getUuid(),RequestID:req.RequestID,MRN:req.MRN,PatientName:req.PatientName,MedicationID:req.MedicationID,Specialty:req.Specialty,Consultant:req.Consultant,DoseNumber:req.DoseNumber,FirstDose:req.FirstDose,AppointmentDate:next.date,BookingStatus:'Booked',BookingType:req.BookingType||'System',CreatedBy:req.CreatedBy,CreatedAt:new Date(),PreviousBookingID:req.PreviousBookingID||'',PreviousAppointmentDate:req.PreviousAppointmentDate||''}; SheetRepository.appendRow(DCU.SHEETS.BOOK,b); SheetRepository.updateRow(DCU.SHEETS.REQ,req.sheetRowNumber,{RequestStatus:'Completed',FinalAppointmentDate:next.date}); MonthlyBookService.updateDay(next.date); AuditService.log('CREATE','Booking Data',b.BookingID,null,{BookingID:b.BookingID,AppointmentDate:b.AppointmentDate},req.Reason); return {status:'Booked',bookingId:b.BookingID,date:next.date};} finally{lock.releaseLock();}}
return {createRequest:createRequest,processRequest:processRequest,manualAdd:function(d){return createRequest(d,'Manual');}};})();
