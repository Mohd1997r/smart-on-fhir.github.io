var MonthlyBookService=(function(){var SECTIONS=['Cardio','Other Procedure','IVIG Infusion','Blood Transfusion','Infusion']; var COLS=['No','Patient Name','MRN','Mobile No','Diagnosis / Medication','Appointment / Readmission Date','Doctor','Rebooking Date']; function monthName(date){var d=new Date(date+'T00:00:00Z'), m=['January','February','March','April','May','June','July','August','September','October','November','December']; return d.getUTCFullYear()+' '+m[d.getUTCMonth()];} function updateDay(date){var ss=SheetRepository.ss(), sh=ss.getSheetByName(monthName(date)); if(!sh) return; var values=sh.getDataRange().getValues(); for(var r=0;r<values.length;r++){if(String(values[r][0])===date){sh.getRange(r+1,1,Math.min(30,sh.getMaxRows()-r),COLS.length).clearContent(); break;}} var books=SheetRepository.readTable(DCU.SHEETS.BOOK).filter(function(b){return b.AppointmentDate===date&&b.BookingStatus==='Booked';}); var start=r>=values.length?sh.getLastRow()+2:r+1; var out=[[date].concat(new Array(COLS.length-1).fill(''))]; SECTIONS.forEach(function(s){out.push([s].concat(new Array(COLS.length-1).fill(''))); books.forEach(function(b,i){out.push([i+1,b.PatientName,b.MRN,'',b.MedicationID,b.AppointmentDate,b.Consultant,b.PreviousAppointmentDate||'']);});}); sh.getRange(start,1,out.length,COLS.length).setValues(out);} return {updateDay:updateDay,monthName:monthName};})();
