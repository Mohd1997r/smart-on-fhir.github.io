var AuditService=(function(){function log(action,entity,id,oldValue,newValue,reason){var actor='system'; try{actor=Session.getActiveUser().getEmail()||'system';}catch(e){} SheetRepository.appendRow(DCU.SHEETS.AUDIT,{AuditID:Utilities.getUuid(),ActorEmail:actor,Action:action,Entity:entity,EntityID:id,OldValue:oldValue?JSON.stringify(oldValue):'',NewValue:newValue?JSON.stringify(newValue):'',Reason:reason||'',CreatedAt:new Date()});} return {log:log};})();
