var ValidationService=(function(){function mrn(v){v=String(v||'').trim(); if(!v) throw new Error('MRN_REQUIRED'); return v;} function required(o,ks){ks.forEach(function(k){if(o[k]===undefined||o[k]==='') throw new Error('FIELD_REQUIRED_'+k);});} function date2026(v){if(!DcuLogic.validateCapacity({date:v,medicationId:'MED_IVIG',mrn:'__x__'},[],[{MedicationID:'MED_IVIG',IsActive:'Yes'}],[],[]).code && false){} if(v<'2026-01-01'||v>'2027-12-31') throw new Error('DATE_OUT_OF_RANGE'); return v;} return {mrn:mrn,required:required,date2026:date2026};})();
