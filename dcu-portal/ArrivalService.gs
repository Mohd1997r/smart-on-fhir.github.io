var ArrivalService=(function(){function recordArrival(data){var u=AuthService.requireRole(['Admin','Manager','Charge Nurse','Booking Staff','Nurse']); ValidationService.required(data,['VisitDate','MRN','PatientName','Specialty','MedicationID','ArrivalStatus','TreatmentStatus']); var p=PatientService.upsertBasic(data,u); var visit={VisitID:Utilities.getUuid(),VisitDate:data.VisitDate,ArrivalTime:data.ArrivalTime||Utilities.formatDate(new Date(),DCU.TZ,'HH:mm'),PatientName:data.PatientName,MRN:ValidationService.mrn(data.MRN),Room:data.Room||'',Specialty:data.Specialty,Consultant:data.Consultant||'',Diagnosis:data.Diagnosis||'',MedicationID:data.MedicationID,DoseNumber:data.DoseNumber||'',FirstDose:String(data.DoseNumber)==='1'?'Yes':(data.FirstDose?'Yes':'No'),PrimaryNurse:data.PrimaryNurse||u.email,ArrivalStatus:data.ArrivalStatus,TreatmentStatus:data.TreatmentStatus,LabsStatus:data.LabsStatus||'',ConsentStatus:data.ConsentRequired||'',SickLeave:data.SickLeaveNeeded||'No',WatcherLeave:data.WatcherLeaveNeeded||'No',HomeMedicationRefill:data.HomeMedicationRefillNeeded||'No',NextAppointmentDate:'',Notes:data.OtherNotes||'',PatientID:p.PatientID,CreatedBy:u.email,CreatedAt:new Date()}; SheetRepository.appendRow(DCU.SHEETS.ARRIVALS,visit); SheetRepository.appendRow(DCU.SHEETS.VISIT_LOG,visit); if(visit.ArrivalStatus!=='Not Arrived') NoArrivalService.closeForArrival(visit.MRN,visit.VisitDate); if(data.TreatmentStatus==='Given' && data.NoNextAppointmentRequired!=='Yes'){ if(data.FinalAppointmentDate && data.SuggestedNextAppointmentDate && data.FinalAppointmentDate!==data.SuggestedNextAppointmentDate && !data.DateOverrideReason) throw new Error('DATE_OVERRIDE_REASON_REQUIRED'); var res=BookingService.createRequest({MRN:visit.MRN,PatientName:visit.PatientName,MedicationID:visit.MedicationID,Specialty:visit.Specialty,Consultant:visit.Consultant,DoseNumber:Number(visit.DoseNumber||0)+1,FirstDose:false,RequestedAppointmentDate:data.FinalAppointmentDate||data.SuggestedNextAppoint