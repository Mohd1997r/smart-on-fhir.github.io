var ChangeService=(function(){function activeByMrn(mrn){var u=AuthService.requireRole(['Admin','Manager','Charge Nurse','Booking Staff','Nurse']); return AuthService.filterRowsByUser(SheetRepository.readTable(DCU.SHEETS.BOOK).filter(function(b){return b.MRN===ValidationService.mrn(mrn)&&['Submitted','Booked','Pending','Need Review'].indexOf(b.BookingStatus)>=0;}),u);} function changeAppointment(d){var u=AuthService.requireRole(['Admin','Manager','Charge Nurse','Booking Staff','Nurse']); ValidationService.required(d,['MRN','BookingID','RequestedNewDate','ChangeReason']); var lock=LockService.getScriptLock(); lock.waitLock(30000); try{var books=SheetRepository.readTable(DCU.SHEETS.BOOK), old=books.filter(function(b){return b.BookingID===d.BookingID&&b.MRN===d.MRN&&['Submitted','Booked','Pending','Need Review'].indexOf(b.BookingStatus)>=0;})[0]; if(!old) throw new Error('BOOKING_NOT_FOUND_FOR_MRN'); var next=CapacityService.next({date:d.RequestedNewDate,mrn:d.MRN,medicationId:old.MedicationID,firstDose:old.FirstDose==='Yes'}); if(next.requiresConfirmation&&!d.ConfirmAlternative) return next; var change={ChangeID:Utilities.getUuid(),MRN:d.MRN,PreviousBookingID:old.BookingID,PreviousAppointmentDate:old.AppointmentDate,RequestedNewDate:d.RequestedNewDate,FinalNewDate:next.date,ChangeReason:d.ChangeReason,ChangeStatus:next.date?'Completed':'Need Review',CreatedBy:u.email,CreatedAt:new Date()}; SheetRepository.appendRow(DCU.SHEETS.CHANGES,change); if(!next.date) return next; var nb=Object.assign({},old,{BookingID:Utilities.getUuid(),AppointmentDate:next.date,PreviousBookingID:old.BookingID,PreviousAppointmentDate:old.AppointmentDate,BookingStatus:'Booked',CreatedBy:u.email,CreatedAt:new Date()}); delete nb.sheetRowNumber; SheetRepository.appendRow(DCU.SHEETS.BOOK,nb); try{SheetRepository.updateRow(DCU.SHEETS.BOOK,old.sheetRowNumber,{BookingStatus:'Changed',ModifiedBy:u.email,ModifiedAt:new Date(),ChangeReason:d.ChangeReason});}catch(e){SheetRepository.updateRow(DCU.SHEETS.BOOK,SheetRepository.readTable(DCU.SHEETS.BOOK).filter(function(x){return x.BookingID===nb.BookingID;})[0].sheetRowNumber,{BookingStatus:'Need Review'}); throw e;} MonthlyBookService.updateDay(old.AppointmentDate); MonthlyBookService.updateDay(next.date); AuditService.log('CHANGE','Booking Data',old.BookingID,{AppointmentDate:old.AppointmentDate},{NewBookingID:nb.BookingID,AppointmentDate:next.date},d.ChangeReason); return {status:'Booked',bookingId:nb.BookingID,date:next.date};} finally{lock.releaseLock();}} return {activeByMrn:activeByMrn,changeAppointment:changeAppointment};})();
