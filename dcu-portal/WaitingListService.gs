var WaitingListService=(function(){function create(req,reason){var row={WaitingID:Utilities.getUuid(),RequestID:req.RequestID,MRN:req.MRN,MedicationID:req.MedicationID,RequestedDate:req.RequestedAppointmentDate,Status:'Waiting',Reason:reason,CreatedAt:new Date()}; SheetRepository.appendRow(DCU.SHEETS.WAIT,row); return row;} function confirm(id){var u=AuthService.requireRole(['Admin','Manager','Charge Nurse','Booking Staff']); var r=SheetRepository.readTable(DCU.SHEETS.WAIT).filter(function(x){return x.WaitingID===id&&x.Status==='Accepted';})[0]; if(!r) throw new Error('WAITING_NOT_ACCEPTED'); SheetRepository.updateRow(DCU.SHEETS.WAIT,r.sheetRowNumber,{ConfirmedBy:u.email,ConfirmedAt:new Date()}); return BookingService.processRequest(r.RequestID,true);} return {create:create,confirm:confirm};})();
