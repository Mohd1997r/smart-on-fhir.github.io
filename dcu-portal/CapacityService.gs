var CapacityService=(function(){function meds(){return SheetRepository.readTable(DCU.SHEETS.MED);} function closed(){return SheetRepository.readTable(DCU.SHEETS.CLOSED);} function rules(){return SheetRepository.readTable(DCU.SHEETS.CAP);} function bookings(){return SheetRepository.readTable(DCU.SHEETS.BOOK).map(function(b){b.AppointmentDate=String(b.AppointmentDate).slice(0,10); return b;});} function evaluate(input){return DcuLogic.validateCapacity(input,bookings(),meds(),closed(),rules());} function next(input){return DcuLogic.findNextAvailable(input,bookings(),meds(),closed(),rules());} return {evaluate:evaluate,next:next};})();
