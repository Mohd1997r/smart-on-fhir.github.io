var NoArrivalService=(function(){function scan(date){var books=SheetRepository.readTable(DCU.SHEETS.BOOK).filter(function(b){return b.AppointmentDate===date&&b.BookingStatus==='Booked';}); var arr=SheetRepository.readTable(DCU.SHEETS.ARRIVALS).filter(function(a){return a.VisitDate===date&&a.ArrivalStatus!=='Not Arrived';}).map(function(a){return a.MRN;}); books.forEach(function(b){if(arr.indexOf(b.MRN)<0){SheetRepository.appendRow(DCU.SHEETS.NOARR,{NoArrivalID:Utilities.getUuid(),BookingID:b.BookingID,MRN:b.MRN,AppointmentDate:date,Status:'Open',CreatedAt:new Date()});}});} function closeForArrival(mrn,date){SheetRepository.readTable(DCU.SHEETS.NOARR).filter(function(n){return n.MRN===mrn&&n.AppointmentDate===date&&n.Status==='Open';}).forEach(function(n){SheetRepository.updateRow(DCU.SHEETS.NOARR,n.sheetRowNumber,{Status:'Closed',ClosedAt:new Date()});});} return {scan:scan,closeForArrival:closeForArrival};})();
