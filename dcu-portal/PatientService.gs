var PatientService=(function(){function findByMrn(mrn){mrn=ValidationService.mrn(mrn); return SheetRepository.readTable(DCU.SHEETS.PATIENTS).filter(function(p){return p.MRN===mrn;})[0]||null;} function upsertBasic(data,user){var mrn=ValidationService.mrn(data.MRN); var found=findByMrn(mrn); if(found) return found; var row={PatientID:Utilities.getUuid(),MRN:mrn,PatientName:data.PatientName||'TEST PATIENT - LOCAL ONLY',MobileNumber:data.MobileNumber||'',Specialty:data.Specialty||'',Consultant:data.Consultant||'',CreatedBy:user.email,CreatedAt:new Date(),ModifiedBy:user.email,ModifiedAt:new Date()}; SheetRepository.appendRow(DCU.SHEETS.PATIENTS,row); AuditService.log('CREATE','Patients',row.PatientID,null,{MRN:'REDACTED'},'patient upsert'); return row;} return {findByMrn:findByMrn,upsertBasic:upsertBasic};})();
