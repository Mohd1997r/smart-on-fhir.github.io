function createBookingRequest_(u,data,type){var reqId=uuid_('REQ'), mrn=normalizeMrn_(data.MRN), med=DcuLogic.medById(data.MedicationID); if(!med) throw appError_('MEDICATION_REQUIRED','Medication required.'); validateDateInRange_(data.RequestedAppointmentDate); var req={RequestID:reqId,IdempotencyKey:sanitizeText_(data.IdempotencyKey),RequestType:type||'Standard',MRN:mrn,PatientName:sanitizeText_(data.PatientName),MedicationID:med.MedicationID,MedicationName:med.GenericName,Specialty:sanitizeText_(data.Specialty),Consultant:sanitizeText_(data.Consultant),DoseNumber:data.DoseNumber||'',FirstDose:DcuLogic.truthy(data.FirstDose)?'Yes':'No',RequestedAppointmentDate:data.RequestedAppointmentDate,Status:'New',Reason:sanitizeText_(data.Reason),CreatedAt:now_(),CreatedBy:u.email}; appendRow_('Booking Requests',req); return req;}
function processBookingRequest_(u,req,confirmAlternative){var lock=LockService.getScriptLock(); lock.waitLock(30000); try{var cand={MRN:req.MRN,MedicationID:req.MedicationID,FirstDose:req.FirstDose}; var found=capacityFind_(req.RequestedAppointmentDate,cand); if(found.status==='Need Review'){updateRow_('Booking Requests',req.sheetRowNumber||findBy_('Booking Requests','RequestID',req.RequestID)[0].sheetRowNumber,{Status:'Need Review',ErrorCode:found.code,ProcessedAt:now_()}); appendRow_('Waiting List',{WaitingListID:uuid_('WL'),RequestID:req.RequestID,MRN:req.MRN,MedicationID:req.MedicationID,RequestedDate:req.RequestedAppointmentDate,Status:'Waiting',CreatedAt:now_(),CreatedBy:u.email}); return found;} if(found.date!==req.RequestedAppointmentDate && !confirmAlternative){updateRow_('Booking Requests',findBy_('Booking Requests','RequestID',req.RequestID)[0].sheetRowNumber,{Status:'Alternative Offered',SuggestedDate:found.date,ErrorCode:found.code,ProcessedAt:now_()}); return {status:'Awaiting Nurse Confirmation',suggestedDate:found.date,requestId:req.RequestID};} var existing=findBy_('Booking Data','RequestID',req.RequestID).filter(function(b){return b.BookingStatus==='Booked';})[0]; if(existing) return {status:'Completed',bookingId:existing.BookingID}; var bId=uuid_('BKG'); appendRow_('Booking Data',{BookingID:bId,RequestID:req.RequestID,MRN:req.MRN,PatientName:req.PatientName,MedicationID:req.MedicationID,MedicationName:req.MedicationName,Specialty:req.Specialty,Consultant:req.Consultant,AppointmentDate:found.date,DoseNumber:req.DoseNumber,FirstDose:req.FirstDose,BookingStatus:'Booked',BookingType:req.RequestType==='Manual'?'Manual':'Standard',BookingCategory:DcuLogic.medById(req.MedicationID).BookingCategory,TreatmentReadiness:'Ready',Reason:req.Reason,CreatedAt:now_(),CreatedBy:u.email}); updateRow_('Booking Requests',findBy_('Booking Requests','RequestID',req.RequestID)[0].sheetRowNumber,{Status:'Completed',FinalAppointmentDate:found.date,ProcessedAt:now_(),ConfirmedAt:confirmAlternative?now_():'',ConfirmedBy:confirmAlternative?u.email:''}); audit_(u,'CREATE','Booking',bId,{}, {AppointmentDate:found.date,MedicationID:req.MedicationID},req.Reason); updateMonthlyDay_(found.date); return {status:'Completed',bookingId:bId,appointmentDate:found.date}; } finally {lock.releaseLock();}}
function apiAddManualAppointment(data){var u=requireRole_(['Admin','Manager','Charge Nurse','Booking Staff','Nurse']); if(!sanitizeText_(data.Reason)) throw appError_('REASON_REQUIRED','Reason is required.'); var req=createBookingRequest_(u,data,'Manual'); return processBookingRequest_(u,req,DcuLogic.truthy(data.ConfirmAlternative));}
function apiConfirmBookingRequest(requestId){var u=requireRole_(['Admin','Manager','Charge Nurse','Booking Staff','Nurse']); var req=findBy_('Booking Requests','RequestID',requestId)[0]; if(!req) throw appError_('REQUEST_NOT_FOUND','Request not found.'); return processBookingRequest_(u,req,true);}
function bookingFromArrival_(u,arrival){ if(arrival.TreatmentStatus!=='Given'||DcuLogic.truthy(arrival.NoNextAppointmentRequired)) return {status:'No Appointment Required'}; var date=arrival.FinalAppointmentDate||arrival.SuggestedNextAppointmentDate; if(!date) return {status:'Need Review',code:'NEXT_DATE_MISSING'}; var req=createBookingRequest_(u,{MRN:arrival.MRN,PatientName:arrival.PatientName,MedicationID:arrival.MedicationID,Specialty:arrival.Specialty,Consultant:arrival.Consultant,DoseNumber:arrival.DoseNumber,FirstDose:arrival.FirstDose,RequestedAppointmentDate:date,Reason:arrival.DateOverrideReason||'Arrival follow-up'},'Arrival'); return processBookingRequest_(u,req,false);}
