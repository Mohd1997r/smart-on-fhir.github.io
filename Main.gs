function doGet(e){var t=HtmlService.createTemplateFromFile('Index'); t.initialRoute=(e&&e.parameter&&e.parameter.route)||'home'; return t.evaluate().setTitle('DCU Operations & Booking Portal').setXFrameOptionsMode(HtmlService.XFrameOptionsMode.DENY).addMetaTag('viewport','width=device-width, initial-scale=1').addMetaTag('robots','noindex,nofollow');}
function include(filename){return HtmlService.createHtmlOutputFromFile(filename).getContent();}
function safeApi_(fn){try{return fn();}catch(e){audit_({email:'server'},'ERROR','API','',{}, {},'',e.code||'ERROR'); return {error:true,code:e.code||'ERROR',message:e.message||'Unexpected error'};}}
function apiSearchBookings(criteria){var u=requireRole_(['Admin','Manager','Charge Nurse','Booking Staff','Nurse','Doctor','Read Only']); criteria=criteria||{}; return readTable_('Booking Data').rows.filter(function(b){return canSeeSpecialty_(u,b.Specialty);}).filter(function(b){return !criteria.MRN||b.MRN===criteria.MRN;}).filter(function(b){return !criteria.BookingID||b.BookingID===criteria.BookingID;}).filter(function(b){return !criteria.MedicationID||b.MedicationID===criteria.MedicationID;}).filter(function(b){return !criteria.AppointmentDate||b.AppointmentDate===criteria.AppointmentDate;}).filter(function(b){return !criteria.Specialty||b.Specialty===criteria.Specialty;}).filter(function(b){return !criteria.Consultant||String(b.Consultant).indexOf(criteria.Consultant)>=0;}).filter(function(b){return !criteria.BookingStatus||b.BookingStatus===criteria.BookingStatus;}).map(function(b){if(!u.canViewMobile) b.MobileNumber=''; if(!u.canViewMRN) b.MRN='Restricted'; return b;});}
