function apiConfirmWaitingList(id,accepted){var u=requireRole_(['Admin','Manager','Charge Nurse','Booking Staff']); var r=findBy_('Waiting List','WaitingListID',id)[0]; if(!r) throw appError_('WAITING_NOT_FOUND','Waiting list record not found.'); if(r.Status!=='Offered'&&r.Status!=='Accepted') throw appError_('WAITING_NOT_OFFERED','Must be offered before booking.'); updateRow_('Waiting List',r.sheetRowNumber,{Status:accepted?'Accepted':'Declined',ConfirmedBy:u.email,ConfirmedAt:now_()}); return {status:accepted?'Accepted':'Declined'};}
