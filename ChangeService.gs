function apiListActiveBookingsByMrn(mrn){var u=requireRole_(['Admin','Manager','Charge Nurse','Booking Staff','Nurse']); mrn=normalizeMrn_(mrn); return readTable_('Booking Data').rows.filter(function(b){return b.MRN===mrn && ['Submitted','Booked','Pending','Need Review'].indexOf(b.BookingStatus)>=0;}).map(function(b){return {BookingID:b.BookingID,AppointmentDate:b.AppointmentDate,MedicationName:b.MedicationName,MedicationID:b.MedicationID,BookingStatus:b.BookingStatus};});}
function apiChangeAppointment(data){var u=requireRole_(['Admin','Manager','Charge Nurse','Booking Staff']); var mrn=normalizeMrn_(data.MRN); if(!sanitizeText_(data.Reason)) throw appError_('REASON_REQUIRED','Change reason is required.'); validateDateInRange_(data.RequestedNewDate); var lock=LockService.getScriptLock(); lock.waitLock(30000); try{var old=findBy_('Booking Data','BookingID',data.BookingID)[0]; if(!old||old.MRN!==mrn) throw appError_('BOOKING_MRN_MISMATCH','Booking does not belong to MRN.'); var cand={MRN:mrn,MedicationID:old.MedicationID,FirstDose:old.FirstDose}; var found=capacityFind_(data.RequestedNewDate,cand); var chId=uuid_('CHG'); appendRow_('Change Requests',{ChangeID:chId,BookingID:old.BookingID,MRN:mrn,PreviousAppointmentDate:old.AppointmentDate,RequestedNewDate:data.RequestedNewDate,FinalNewDate:found.date,Status:found.status==='Need Review'?'Need Review':'Completed',Reason:sanitizeText_(data.Reason),CreatedAt:now_(),CreatedBy:u.email,ProcessedAt:now_(),ErrorCode:found.code}); if(found.status==='Need Review') return {status:'Need Review',changeId:chId,code:found.code}; var newId=uuid_('BKG'); appendRow_('Booking Data',Object.assign({},old,{sheetRowNumber:undefined,BookingID:newId,PreviousBookingID:old.BookingID,PreviousAppointmentDate:old.AppointmentDate,AppointmentDate:found.date,BookingStatus:'Booked',BookingType:'Changed',Reason:data.Reason,CreatedAt:now_(),CreatedBy:u.email,ModifiedAt:'',ModifiedBy:''})); try{updateRow_('Booking Data',old.sheetRowNumber,{BookingStatus:'Changed',ModifiedAt:now_(),ModifiedBy:u.email,Reason:data.Reason});}catch(e){updateRow_('Booking Data',findBy_('Booking Data','BookingID',newId)[0].sheetRowNumber,{BookingStatus:'Need Review',Reason:'Old booking update failed'}); audit_(u,'ERROR','Booking',newId,{}, {},data.Reason,'OLD_UPDATE_FAILED'); throw e;} audit_(u,'CHANGE','Booking',old.BookingID,{AppointmentDate:old.AppointmentDate},{NewBookingID:newId,AppointmentDate:found.date},data.Reason); updateMonthlyDay_(old.AppointmentDate); updateMonthlyDay_(found.date); return {status:'Completed',changeId:chId,newBookingId:newId,appointmentDate:found.date};} finally{lock.releaseLock();}}
