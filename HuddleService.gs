function apiGetHomeMetrics(date){var u=getCurrentUser_(); date=date||Utilities.formatDate(new Date(),DCU.TZ,'yyyy-MM-dd'); var h=buildHuddle_(u,date); return {cards:{TodayBookings:h.rows.length,Arrived:h.rows.filter(function(r){return r.ArrivalStatus==='Arrived';}).length,NotArrived:h.rows.filter(function(r){return r.ArrivalStatus==='Not Arrived'||!r.ArrivalStatus;}).length,InTreatment:h.rows.filter(function(r){return r.ArrivalStatus==='In Treatment';}).length,Completed:h.rows.filter(function(r){return r.ArrivalStatus==='Completed';}).length,PendingRequests:readTable_('Booking Requests').rows.filter(function(r){return ['New','Processing','Alternative Offered','Awaiting Nurse Confirmation'].indexOf(r.Status)>=0;}).length,ManualAdditions:h.alerts.filter(function(a){return a.type==='Manual Addition';}).length,AppointmentChanges:h.alerts.filter(function(a){return a.type==='Changed Appointment';}).length,CapacityAlerts:h.alerts.filter(function(a){return a.type==='Capacity Full'||a.type==='Failed Booking Request';}).length},lastUpdated:now_()};}
function buildHuddle_(u,date){var bookings=readTable_('Booking Data').rows.filter(function(b){return b.AppointmentDate===date && b.BookingStatus==='Booked' && canSeeSpecialty_(u,b.Specialty);}); var arrivals=readTable_('Arrival Records').rows.filter(function(a){return a.VisitDate===date;}); var byMrn={}; arrivals.forEach(function(a){byMrn[a.MRN]=a;}); var rows=bookings.map(function(b,i){var a=byMrn[b.MRN]||{}; return {Sequence:i+1,Room:a.Room||'',PatientName:b.PatientName,MRN:u.canViewMRN?b.MRN:'Restricted',MobileNumber:u.canViewMobile?b.MobileNumber:'',Responded:a.ArrivalStatus?'Yes':'No',LabsIn:a.LabsStatus||'',Diagnosis:b.Diagnosis||a.Diagnosis,MedicationProcedure:b.MedicationName,Consultant:b.Consultant,Specialty:b.Specialty,AssignedStaff:a.PrimaryNurse||'',Diet:'',ArrivalStatus:a.ArrivalStatus||'Not Arrived',BookingStatus:b.BookingStatus,Notes:u.role==='Doctor'?'':(a.OtherNotes||''),FirstDose:b.FirstDose,MedicationID:b.MedicationID,PreviousAppointmentDate:b.PreviousAppointmentDate,BookingType:b.BookingType};}); var counts={TotalPatients:rows.length,PatientsBySpecialty:{},PatientsByMedication:{},FirstDoseCount:0,ProceduresCount:0,IVIGCount:0,DesferalCount:0,BloodTransfusionCount:0,IronSucroseCount:0,FerinjectCount:0}; rows.forEach(function(r){counts.PatientsBySpecialty[r.Specialty]=(counts.PatientsBySpecialty[r.Specialty]||0)+1; counts.PatientsByMedication[r.MedicationProcedure]=(counts.PatientsByMedication[r.MedicationProcedure]||0)+1; if(DcuLogic.truthy(r.FirstDose)) counts.FirstDoseCount++; if(r.MedicationID==='MED_IVIG') counts.IVIGCount++; if(r.MedicationID==='MED_DESFERAL') counts.DesferalCount++; if(r.MedicationID==='PROC_BLOOD') counts.BloodTransfusionCount++; if(r.MedicationID==='MED_IRON_SUCROSE') counts.IronSucroseCount++; if(r.MedicationID==='MED_FERINJECT') counts.FerinjectCount++; if(DcuLogic.medById(r.MedicationID)&&DcuLogic.medById(r.MedicationID).ItemType==='Procedure') counts.ProceduresCount++;}); var alerts=[]; rows.forEach(function(r){if(r.BookingType==='Manual') alerts.push({type:'Manual Addition',booking:r}); if(r.BookingType==='Changed') alerts.push({type:'Changed Appointment',previous:r.PreviousAppointmentDate,booking:r}); if(r.ArrivalStatus==='Not Arrived') alerts.push({type:'No Arrival',booking:r}); if(r.LabsIn==='Missing Labs') alerts.push({type:'Missing Labs',booking:r});}); readTable_('Booking Requests').rows.filter(function(q){return ['Failed','Need Review'].indexOf(q.Status)>=0;}).forEach(function(q){alerts.push({type:'Failed Booking Request',requestId:q.RequestID,code:q.ErrorCode});}); return {date:date,counts:counts,rows:rows,alerts:alerts,lastUpdated:now_()};}
function apiGetHuddle(date){return buildHuddle_(getCurrentUser_(),date||Utilities.formatDate(new Date(),DCU.TZ,'yyyy-MM-dd'));}
function apiGetDoctorDashboard(specialty,date){var u=getCurrentUser_(); requireSpecialty_(u,specialty); return buildHuddle_(u,date||Utilities.formatDate(new Date(),DCU.TZ,'yyyy-MM-dd')).rows.filter(function(r){return r.Specialty===specialty;});}
function apiGetManagerView(date){requireRole_(['Admin','Manager','Charge Nurse']); return apiGetHuddle(date);}
