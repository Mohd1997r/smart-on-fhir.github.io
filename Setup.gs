function installSystem(){var ss=SpreadsheetApp.create('DCU Booking Book 2026-2027'); PropertiesService.getScriptProperties().setProperty('SPREADSHEET_ID',ss.getId()); Object.keys(TABLES).forEach(function(n){ensureSheet_(ss,n,TABLES[n]);}); seedReference_(ss,false); createMonthlySheets_(ss); installTriggers_(); appendRow_('System Config',{ConfigKey:'SYSTEM_MODE',ConfigValue:'SETUP',UpdatedAt:now_(),UpdatedBy:'installSystem'}); appendRow_('System Config',{ConfigKey:'SCHEMA_VERSION',ConfigValue:DCU.SCHEMA_VERSION,UpdatedAt:now_(),UpdatedBy:'installSystem'}); return {spreadsheetId:ss.getId(),mode:'SETUP'};}
function migrateSystem(){var ss=getSpreadsheet_(); var backup=DriveApp.getFileById(ss.getId()).makeCopy('DCU Booking Book backup '+now_()); Object.keys(TABLES).forEach(function(n){ensureSheet_(ss,n,TABLES[n]);}); seedReference_(ss,true); createMonthlySheets_(ss); appendRow_('System Config',{ConfigKey:'SCHEMA_VERSION',ConfigValue:DCU.SCHEMA_VERSION,UpdatedAt:now_(),UpdatedBy:'migrateSystem'}); audit_({email:'system'},'MIGRATE','System',DCU.SCHEMA_VERSION,{}, {backupId:backup.getId()},''); return {status:'Migrated',backupId:backup.getId()};}
function seedReference_(ss,skipExisting){if(!skipExisting||readTableSafe_(ss,'Medication Master').length===0){var sh=ensureSheet_(ss,'Medication Master',TABLES['Medication Master']); if(sh.getLastRow()<2) sh.getRange(2,1,DCU.MEDS.length,14).setValues(DCU.MEDS);} if(!skipExisting||readTableSafe_(ss,'Specialty Master').length===0){var rows=DCU.SPECIALTIES.map(function(s,i){return ['SPC_'+(i+1),s[0],s[1],s[2],'Yes'];}); ensureSheet_(ss,'Specialty Master',TABLES['Specialty Master']).getRange(2,1,rows.length,5).setValues(rows);} if(!skipExisting||readTableSafe_(ss,'Capacity Rules').length===0){var rules=[['R_WEEKEND_TOTAL','Weekend total','Weekend','','Total',20,'Yes','Owner',''],['R_WEEKEND_IRON','Weekend Iron Sucrose','Weekend','MED_IRON_SUCROSE','Medication',10,'Yes','Owner',''],['R_WEEKEND_FER','Weekend Ferinject','Weekend','MED_FERINJECT','Medication',10,'Yes','Owner',''],['R_FIRST','First dose','Any','','FirstDose',2,'Yes','Owner',''],['R_WEEKDAY_TOTAL','Weekday total','Weekday','','Total',20,'Yes','Owner',''],['R_PROCEDURE','Procedure weekday','Weekday','','Procedure',2,'Yes','Owner',''],['R_IVIG','IVIG weekday','Weekday','MED_IVIG','Medication',2,'Yes','Owner',''],['R_DESFERAL','Desferal weekday','Weekday','MED_DESFERAL','Medication',2,'Yes','Owner',''],['R_BLOOD','Blood weekday','Weekday','PROC_BLOOD','Medication',2,'Yes','Owner','']]; ensureSheet_(ss,'Capacity Rules',TABLES['Capacity Rules']).getRange(2,1,rules.length,9).setValues(rules);} }
function readTableSafe_(ss,name){var sh=ss.getSheetByName(name); if(!sh||sh.getLastRow()<2) return []; return sh.getRange(2,1,sh.getLastRow()-1,1).getValues().filter(function(r){return r[0];});}
function createMonthlySheets_(ss){for(var y=2026;y<=2027;y++){for(var m=1;m<=12;m++){var name=y+' '+['January','February','March','April','May','June','July','August','September','October','November','December'][m-1]; var sh=ss.getSheetByName(name)||ss.insertSheet(name); if(sh.getLastRow()>0) continue; var rows=[]; for(var d=1;d<=DcuLogic.daysInMonth(y,m);d++){var date=y+'-'+String(m).padStart(2,'0')+'-'+String(d).padStart(2,'0'); rows.push(['DATE:'+date].concat(new Array(MONTH_COLUMNS.length-1).fill(''))); rows.push(MONTH_COLUMNS); MONTH_SECTIONS.forEach(function(sec){rows.push([sec].concat(new Array(MONTH_COLUMNS.length-1).fill('')));}); rows.push(new Array(MONTH_COLUMNS.length).fill(''));} sh.getRange(1,1,rows.length,MONTH_COLUMNS.length).setValues(rows); sh.setFrozenRows(0);}}}
function validateReadiness(){var report=[]; function add(k,ok,msg){report.push({check:k,ok:ok,message:msg});} try{getSpreadsheetId_(); add('Spreadsheet ID',true,'Configured');}catch(e){add('Spreadsheet ID',false,'Missing');} try{add('Admin user',readTable_('Users Roles').rows.some(function(u){return u.Role==='Admin'&&u.IsActive==='Yes';}),'Active Admin required');}catch(e){add('Admin user',false,e.message);} try{add('Capacity Rules',readTable_('Capacity Rules').rows.length>0,'Must be locally approved before LIVE');}catch(e){add('Capacity Rules',false,e.message);} add('System mode',getSystemMode_()==='LIVE','Admin must set SYSTEM_MODE to LIVE'); return {ready:report.every(function(r){return r.ok;}),checks:report};}
