function closeNoArrivalForMrn_(mrn,date,u){readTable_('No Arrival Log').rows.filter(function(r){return r.MRN===mrn&&r.AppointmentDate===date&&r.Status==='Open';}).forEach(function(r){updateRow_('No Arrival Log',r.sheetRowNumber,{Status:'Closed',ClosedAt:now_(),ClosedBy:u.email});});}
function scanNoArrivals_(){var u={email:'trigger'}; var date=Utilities.formatDate(new Date(),DCU.TZ,'yyyy-MM-dd'); var bookings=readTable_('Booking Data').rows.filter(function(b){return b.AppointmentDate===date&&b.BookingStatus==='Booked';}); var arrived={}; readTable_('Arrival Records').rows.filter(function(a){return a.VisitDate===date;}).forEach(function(a){arrived[a.MRN]=true;}); bookings.forEach(function(b){if(!arrived[b.MRN]&&!findBy_('No Arrival Log','BookingID',b.BookingID)[0]) appendRow_('No Arrival Log',{NoArrivalID:uuid_('NA'),BookingID:b.BookingID,AppointmentDate:date,MRN:b.MRN,Status:'Open',AlertType:'Internal',OpenedAt:now_()});});}
